{
  "datasets": [
    {
      "name": "4e4824a8",
      "displayName": "Global Emissions Data by Location Coordinates",
      "queryLines": [
        "SELECT\r\n",
        "  latitude,\r\n",
        "  longitude,\r\n",
        "  `GHG emissions mtons CO2e` AS `emissions.default.emissions_data`\r\n",
        "FROM\r\n",
        "  emission_catalog.default.emissions_data"
      ],
      "catalog": "emission_catalog",
      "schema": "default"
    },
    {
      "name": "290d3e69",
      "displayName": "emissions per person",
      "queryLines": [
        "SELECT\r\n",
        "  county_name,\r\n",
        "  state_abbr,\r\n",
        "    population,\r\n",
        "  CASE\r\n",
        "    WHEN population > 0 THEN try_cast(regexp_replace(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / population\r\n",
        "    ELSE NULL\r\n",
        "  END AS emissions_per_person\r\n",
        "FROM emission_catalog.default.emissions_data\r\n",
        "ORDER BY emissions_per_person DESC;"
      ],
      "catalog": "emission_catalog",
      "schema": "default"
    },
    {
      "name": "063d4a68",
      "displayName": "Total  emission per state",
      "queryLines": [
        "SELECT\r\n",
        "  state_abbr,\r\n",
        "  SUM(try_cast(regexp_replace(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS total_emissions_mtons_co2e\r\n",
        "FROM emission_catalog.default.emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY total_emissions_mtons_co2e DESC\r\n",
        "limit 10;"
      ],
      "catalog": "emission_catalog",
      "schema": "default"
    },
    {
      "name": "b5f7da0d",
      "displayName": "county shaming",
      "queryLines": [
        "select county_state_name, population, cast(replace (`GHG emissions mtons CO2e`, ',', '') as double) as total_emissions from emissions_data \r\n",
        "order by total_emissions desc limit 10;"
      ],
      "catalog": "emission_catalog",
      "schema": "default"
    }
  ],
